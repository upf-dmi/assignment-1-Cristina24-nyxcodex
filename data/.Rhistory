knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(readxl)
library(summarytools)
library(ggpubr)
data <- read_excel("raw_data/Table_S1.xlsx", sheet = "Clinical_information")
head(data)
dim(data)
# How many patients and how many variables/attributes does the data contain?
# The dataset contains 118 samples (rows) and 31 variables/attributes (columns)
# Distinguish the types of variables
colnames(data) # variable names
str(data) # variable types
# Check that the format of the variables with dates is uniform
# unique shows you a representation of the value types you find in a variable
unique(data$`Onset date f`) # year-month-day format + NA - correct
unique(data$`Admission date`) # year-month-day format + NA - correct
unique(data$`Date of progression to severe state`) # excel codes + "/" + NA - fix
unique(data$`Sampling date for metabolomics`) # year-month-day format + NA - correct
unique(data$`Sampling date for proteomics`) # excel codes + "/" + NA - fix
unique(data$`Discharge Date`) # year-month-day format + NA - correct
unique(data$`Test date...18`) # year-month-day format + NA - correct
unique(data$`Test date...23`) # year-month-day format + NA - correct
# Fix the ones that don't follow the rule
# Date of progression to severe state
data$`Date of progression to severe state` <- as.Date(
as.numeric(data$`Date of progression to severe state`),
origin = "1899-12-30"
)
# Sampling date for proteomics
data$`Sampling date for proteomics` <- as.Date(
as.numeric(data$`Sampling date for proteomics`),
origin = "1899-12-30"
)
# Check which variables still contain a "/" character
# Important to check only character variables cause date ones give a POSIXlt error and the converting to date function already handled the NA part
cols_with_slash <- names(which(
sapply(data, function(col) is.character(col) && any(col == "/", na.rm = TRUE))
))
cols_with_slash
data[cols_with_slash] <- lapply(data[cols_with_slash], function(col) {
col[col == "/"] <- NA
col
})
str(data) # variable types
# Convert the date variables that are wrongly defined as POSIXct to Date
posix_cols <- sapply(data, inherits, what = "POSIXt")
data[posix_cols] <- lapply(data[posix_cols], as.Date)
# Convert the BMI and CRP variables, which are wrongly defined as character, to numerical
data[["BMI h"]] <- as.numeric(data[["BMI h"]])
data[["CRP i, mg/L"]] <- as.numeric(data[["CRP i, mg/L"]])
str(data)
# Define Group d and Sex g as factors instead of numerical variables. Also convert the COVID-19 patients cohort from character to factor for clarity
data$`Group d` <- factor(
data$`Group d`,
levels = c(0, 1, 2, 3),
labels = c("healthy", "non-COVID-19", "non-Severe", "Severe")
)
data$`Sex g` <- factor(
data$`Sex g`,
levels = c(0, 1),
labels = c("Female", "Male")
)
data$`COVID-19 patients corhort` <- factor(
data$`COVID-19 patients corhort`,
levels = c("Training (C1)", "Test 1 (C2)", "Test 2 (C3)"),
labels = c("Training", "Test 1", "Test 2")
)
# Remove variables that are not "clinically useful" for EDA to avoid confusions - MS ID b and MSRep ID c are technical variables
data_full <- data # Save the whole dataset in case you need in the future
data_eda <- data_full %>% # Save a copy of the dataset removing the technical variables
select(-`MS ID b`, -`MSRep ID c`, -`Metabolomics ID e`)
# Check missing data/variable
colSums(is.na(data_eda))
round(colSums(is.na(data_eda)) / nrow(data_eda) * 100, 2) # in percentages
# Missing values summary table
library(dplyr)
missing_summary <- data_eda %>%
summarise(across(everything(), ~ sum(is.na(.)))) %>%
pivot_longer(everything(), names_to = "variable", values_to = "missing_number") %>%
mutate(missing_percent = round(missing_number / nrow(data_eda) * 100, 2))
missing_summary
library(naniar)
gg_miss_var(data_eda)
library(dplyr)
missing_by_group <- data_eda %>%
group_by(`Group d`) %>%
summarise(
across(
everything(),
~ round(mean(is.na(.)) * 100, 2),
.names = "{.col}_missing_pct"
)
)
# Missing data plot by group
library(tidyr)
missing_long <- missing_by_group %>%
pivot_longer(
cols = -`Group d`,
names_to = "variable",
values_to = "missing_pct"
)
missing_long <- missing_long %>%  # Renaming for clarity (removing the _missing_pct part)
mutate(variable = gsub("_missing_pct", "", variable))
# Barplot
library(ggplot2)
ggplot(missing_long, aes(x = variable, y = missing_pct, fill = `Group d`)) +
geom_bar(stat = "identity", position = "dodge") +
labs(
title = "Missing Data (%) by Patient Group",
x = "Variable",
y = "% Missing",
fill = "Patient Group"
) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
# Heatmap
ggplot(missing_long, aes(x = variable, y = `Group d`, fill = missing_pct)) +
geom_tile() +
scale_fill_viridis_c(option = "C") +
labs(
title = "Missing Data Heatmap by Patient Group",
x = "Variable",
y = "Patient Group",
fill = "% Missing"
) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
library(summarytools)
dfSummary(data_eda)
View(data_eda)
descr(data_eda[, c("BMI h", "WBC count, x109/L)", "Lymphocyte count, x109/L", "Monocyte count, x109/L", "Platelet count, x109/L", "CRP i, mg/L", "ALT j, U/L", "AST k, U/L", "GGT I, U/L", "TBIL m, μmol/L", "DBIL n, μmol/L", "Creatinine, μmol/L", "Glucose, mmol/L" )])
